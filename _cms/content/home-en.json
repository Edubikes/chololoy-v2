 "family-story": {
  "family_story__text1": "02 — The family",
  "family_story__text2": "Meet the family",
  "family_story__text3": "behind Chololoy®.",
  "family_story__text4": "1",
  "family_story__text5": "/ 3",
  "family_story__text6": "Swipe to follow the story.",
  "family_story__img7": "assets/logo-chef-640.webp",
  "family_story__text8": "Chololoy® Original Seasoning",
  "family_story__text9": "01",
  "family_story__text10": "From Mama Mecho",
  "family_story__text11": "A family recipe, written down by hand.",
  "family_story__text12": "Great-grandma Nemesia García, “Mama Mecho,” from Tlaxcala, kept a tortilla soup recipe in her cookbook. Generations later, it became Chololoy®.",
  "family_story__img13": "assets/victor-550.webp",
  "family_story__text14": "Victor Hitchcock Medina",
  "family_story__text15": "02",
  "family_story__text16": "1990 · Seattle",
  "family_story__text17": "Victor got restaurants hooked.",
  "family_story__text18": "Victor Hitchcock Medina turned Mama Mecho’s soup into a dehydrated seasoning restaurants could make in minutes, then showed the kitchens of Mexican restaurants how to use it.",
  "family_story__img19": "assets/patrick-kristina-fair-1200.webp",
  "family_story__text20": "Patrick Hitchcock with his sister Kristina at a product fair",
  "family_story__text21": "03",
  "family_story__text22": "The family today",
  "family_story__text23": "Patrick and Kristina.",
  "family_story__text24": "Since Victor’s passing, his siblings, Patrick and Kristina, have managed Chololoy®, keeping the recipes, the chef relationships and the family kitchen alive. Every order still goes through their hands.",
  "family_story__text25": "Swipe back anytime, or read the full story.",
  "family_story__text26": "Read the full story",
  "family_story__img27": "assets/spoon-455.webp"
 },
