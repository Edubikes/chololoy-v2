  "tortilla_soup__text2": "A bowl of tortilla soup made with Chololoy®: chicken, avocado, crispy tortilla strips and cheese",
  "tortilla_soup__text3": "01 — Signature product",
  "tortilla_soup__text4": "Victor’s Tortilla Soup.",
  "tortilla_soup__text5": "The one restaurants serve.",
  "tortilla_soup__text6": "Chololoy® started as one dish: the tortilla soup from Victor’s great-grandmother’s cookbook. It’s still what restaurants order from the family: a consistent, homemade-tasting broth that any cook can make on any shift.",
  "tortilla_soup__text7": "Make the broth",
  "tortilla_soup__text8": "Stir 1 tablespoon of Chololoy® into 1 cup of hot water. When it boils, the broth is ready.",
  "tortilla_soup__text9": "Build the bowl",
  "tortilla_soup__text10": "Cubed chicken, avocado, crispy tortilla strips and shredded Monterey Jack cheese.",
  "tortilla_soup__text11": "Pour and serve",
  "tortilla_soup__text12": "Pour the hot broth over the bowl right before serving.",
  "tortilla_soup__text13": "Yield:",
  "tortilla_soup__text14": "4 oz makes 1 gallon of broth. One pound makes 4 gallons. Add 4 lb of chicken for 5 gallons of soup.",
  "tortilla_soup__text15": "Request samples",
  "tortilla_soup__text16": "Full recipe"
 },
