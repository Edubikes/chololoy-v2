 "why": {
  "why__text1": "06 — Why chefs reorder",
  "why__text2": "“Once people try it, they order it again.”",
  "why__text3": "The Hitchcock family, Chololoy®",
  "why__text4": "01",
  "why__text5": "Easy to make",
  "why__text6": "One tablespoon in a cup of hot water. Once it boils, your broth is ready, and it tastes the same every shift.",
  "why__text7": "02",
  "why__text8": "A little goes a long way. Zero waste.",
  "why__text9": "About 52 tablespoons per pound, so you use only what you need.",
  "why__text10": "03",
  "why__text11": "Homemade flavor, 100% natural",
  "why__text12": "Victor’s great-grandmother’s recipe. 100% natural ingredients and no preservatives."
 },
 "story": {
  "story__img1": "assets/victor-550.webp",
  "story__text2": "Victor Hitchcock Medina",
  "story__text3": "Victor Hitchcock Medina",
  "story__img4": "assets/patrick-kristina-fair-1200.webp",
  "story__text5": "Patrick and Kristina today",
  "story__text6": "Patrick and Kristina today",
  "story__text7": "07 — The story",
  "story__text8": "A recipe from",
  "story__text9": "Mama Mecho’s cookbook.",
  "story__text10": "Victor’s great-grandma Nemesia García, “Mama Mecho,” from Tlaxcala, wrote down a tortilla soup recipe. Her great-grandson Victor Hitchcock Medina turned it into a dehydrated seasoning any restaurant could make in minutes, and in 1990 he started showing the kitchens of Mexican restaurants how to use it. He built a market where none existed.",
  "story__text11": "Tlaxcala",
  "story__text12": "Mama Mecho writes down her tortilla soup",
  "story__text13": "1990",
  "story__text14": "Victor brings it to the kitchens of Mexican restaurants",
  "story__text15": "Today his siblings, Patrick and Kristina, carry it on.",
  "story__text16": "Read the full story"
 },
